# Copy this file to .env for local development.
# NEVER commit .env to git.
#
# No bot token belongs here. The bot token is a Worker secret
# (set with `wrangler secret put BOT_TOKEN`) and must never be in the app.

# Optional. Defaults to the production Worker URL if left out.
VITE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
