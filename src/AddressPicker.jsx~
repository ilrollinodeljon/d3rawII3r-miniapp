import { useState, useRef, useEffect, useCallback } from 'react';
import mapboxgl from 'mapbox-gl';
import 'mapbox-gl/dist/mapbox-gl.css';

// npm install mapbox-gl
// .env → VITE_MAPBOX_TOKEN=pk.xxxxx  (get one at account.mapbox.com/access-tokens)
const MAPBOX_TOKEN = import.meta.env.VITE_MAPBOX_TOKEN;

// Default map center when opening the picker with no address yet — set this
// to your delivery city's center so the map doesn't open on the ocean.
const DEFAULT_CENTER = { lng: 7.6869, lat: 45.0703 }; // Turin

function newSessionToken() {
  return crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(36).slice(2)}`;
}

export default function AddressPicker({ value, onChange, required = false, error = null }) {
  const [query, setQuery] = useState(value?.fullAddress || '');
  const [suggestions, setSuggestions] = useState([]);
  const [showSuggestions, setShowSuggestions] = useState(false);
  const [showMap, setShowMap] = useState(false);
  const [loading, setLoading] = useState(false);

  const sessionToken = useRef(newSessionToken());
  const debounceRef = useRef(null);
  const mapContainerRef = useRef(null);
  const mapRef = useRef(null);
  const markerRef = useRef(null);
  const wrapRef = useRef(null);

  // Sync external value changes
  useEffect(() => {
    if (value?.fullAddress) {
      setQuery(value.fullAddress);
    }
  }, [value?.fullAddress]);

  // Close suggestions on outside click
  useEffect(() => {
    const onClick = (e) => {
      if (wrapRef.current && !wrapRef.current.contains(e.target)) setShowSuggestions(false);
    };
    document.addEventListener('mousedown', onClick);
    return () => document.removeEventListener('mousedown', onClick);
  }, []);

  // Search-as-you-type
  const fetchSuggestions = useCallback(async (text) => {
    if (!text || text.trim().length < 3) {
      setSuggestions([]);
      return;
    }
    setLoading(true);
    try {
      const params = new URLSearchParams({
        q: text,
        access_token: MAPBOX_TOKEN,
        session_token: sessionToken.current,
        language: 'it',
        country: 'it',
        types: 'address,street,place',
        limit: '5',
      });
      const res = await fetch(`https://api.mapbox.com/search/searchbox/v1/suggest?${params}`);
      const data = await res.json();
      setSuggestions(data.suggestions || []);
    } catch (err) {
      console.error('Address suggest failed:', err);
      setSuggestions([]);
    } finally {
      setLoading(false);
    }
  }, []);

  const handleInputChange = (e) => {
    const text = e.target.value;
    setQuery(text);
    setShowSuggestions(true);
    if (debounceRef.current) clearTimeout(debounceRef.current);
    debounceRef.current = setTimeout(() => fetchSuggestions(text), 300);
  };

  // Apply location with improved parsing
  const applyLocation = (feature, fallbackText) => {
    const [lng, lat] = feature.geometry.coordinates;
    const props = feature.properties || {};
    const context = props.context || {};

    const fullAddress = props.full_address || 
                       props.place_formatted || 
                       props.name || 
                       fallbackText || 
                       query;

    const street = props.name_preferred || 
                  context.street?.name || 
                  props.name || 
                  props.address || '';

    const houseNumber = context.address?.address_number || 
                       props.address_number || 
                       props.house_number || '';

    const addressData = {
      fullAddress,
      street,
      houseNumber,
      city: context.place?.name || context.locality?.name || context.region?.name || '',
      postcode: context.postcode?.name || '',
      lat,
      lng,
    };

    setQuery(fullAddress);
    setShowSuggestions(false);
    onChange?.(addressData);
    placeMarker(lng, lat);
  };

  // User picked a suggestion
  const selectSuggestion = async (suggestion) => {
    setLoading(true);
    try {
      const params = new URLSearchParams({
        access_token: MAPBOX_TOKEN,
        session_token: sessionToken.current,
      });
      const res = await fetch(
        `https://api.mapbox.com/search/searchbox/v1/retrieve/${suggestion.mapbox_id}?${params}`
      );
      const data = await res.json();
      const feature = data.features?.[0];
      if (feature) applyLocation(feature, suggestion.full_address || suggestion.name);
      sessionToken.current = newSessionToken();
    } catch (err) {
      console.error('Address retrieve failed:', err);
    } finally {
      setLoading(false);
    }
  };

  // Reverse geocode on map drag
  const reverseGeocode = useCallback(async (lng, lat) => {
    setLoading(true);
    try {
      const params = new URLSearchParams({
        access_token: MAPBOX_TOKEN,
        longitude: String(lng),
        latitude: String(lat),
      });
      const res = await fetch(`https://api.mapbox.com/search/searchbox/v1/reverse?${params}`);
      const data = await res.json();
      const feature = data.features?.[0];
      if (feature) {
        applyLocation({ ...feature, geometry: { coordinates: [lng, lat] } });
      }
    } catch (err) {
      console.error('Reverse geocode failed:', err);
    } finally {
      setLoading(false);
    }
  }, []);

  const placeMarker = (lng, lat) => {
    if (!mapRef.current || !markerRef.current) return;
    mapRef.current.flyTo({ center: [lng, lat], zoom: 16 });
    markerRef.current.setLngLat([lng, lat]);
  };

  const openMapPicker = () => {
    setShowMap(true);
    requestAnimationFrame(() => {
      if (!mapContainerRef.current || mapRef.current) return;
      const start = value?.lng
        ? { lng: value.lng, lat: value.lat }
        : DEFAULT_CENTER;

      mapboxgl.accessToken = MAPBOX_TOKEN;
      mapRef.current = new mapboxgl.Map({
        container: mapContainerRef.current,
        style: 'mapbox://styles/mapbox/dark-v11',
        center: [start.lng, start.lat],
        zoom: value?.lng ? 16 : 12,
      });
      mapRef.current.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'top-right');

      markerRef.current = new mapboxgl.Marker({ color: '#ffe224', draggable: true })
        .setLngLat([start.lng, start.lat])
        .addTo(mapRef.current);

      markerRef.current.on('dragend', () => {
        const { lng, lat } = markerRef.current.getLngLat();
        reverseGeocode(lng, lat);
      });
    });
  };

  useEffect(() => {
    return () => {
      mapRef.current?.remove();
      mapRef.current = null;
    };
  }, []);

  return (
    <div className="address-picker field-group" ref={wrapRef}>
      <div className="address-search-row">
        <div className={`field-icon-wrap ${error ? 'field-error' : ''}`}>
          <input
            className="field"
            style={{ paddingLeft: 40 }}
            type="text"
            placeholder="Via, numero civico, città"
            value={query}
            onChange={handleInputChange}
            onFocus={() => setShowSuggestions(true)}
            required={required}
          />
        </div>
        <button
          type="button"
          className="map-toggle-btn"
          onClick={openMapPicker}
          aria-label="Seleziona sulla mappa"
        >
          🗺️
        </button>
      </div>

      {showSuggestions && suggestions.length > 0 && (
        <div className="suggestion-list glass">
          {suggestions.map((s) => (
            <div key={s.mapbox_id} className="suggestion-item" onClick={() => selectSuggestion(s)}>
              <div className="suggestion-text">
                <div className="suggestion-name">{s.name}</div>
                <div className="suggestion-sub">{s.full_address || s.place_formatted}</div>
              </div>
            </div>
          ))}
        </div>
      )}

      {showMap && (
        <div className="map-picker-wrap fade-up">
          <div ref={mapContainerRef} className="map-picker" />
          <p className="field-hint">📍 Trascina il pin per regolare la posizione esatta</p>
        </div>
      )}

      {loading && <p className="field-hint">Ricerca in corso…</p>}
      {error && <p className="error-text">{error}</p>}
    </div>
  );
}
